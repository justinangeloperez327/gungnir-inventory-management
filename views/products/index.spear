<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }} · Gungnir Inventory</title></head>
<body><main>
<a href="/">Dashboard</a> · <a href="/categories">Categories</a>
<form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf }}"><button>Sign out</button></form>
<h1>Products</h1>
<p>SKU-ordered catalog, maximum 20 per page. Inventory movement and quantity edits are disabled.</p>
<table><thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Price (minor)</th><th>In stock</th><th>Reorder level</th></tr></thead><tbody>
@forelse(products as product)
<tr><td>{{ product.sku }}</td><td>{{ product.name }}</td><td>{{ product.category_id }}</td><td>{{ product.unit_price_minor }}</td><td>{{ product.stock_on_hand }}</td><td>{{ product.reorder_level }}</td></tr>
@empty
<tr><td colspan="6">No products yet</td></tr>
@endforelse
</tbody></table>
@if(more)<p><a href="/products?after={{ next }}">Next →</a></p>@endif
</main></body></html>
