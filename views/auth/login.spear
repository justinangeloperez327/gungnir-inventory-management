<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Gungnir Inventory</title>
</head>
<body>
<main>
  <h1>Gungnir Inventory</h1>
  <h2>Sign in</h2>
  @if(error)
    <p role="alert">{{ error }}</p>
  @endif
  <form action="/login" method="post">
    <input type="hidden" name="_token" value="{{ csrf }}">
    <p><label for="email">Email</label>
       <input id="email" name="email" type="email" maxlength="254" autocomplete="username" required></p>
    <p><label for="password">Password</label>
       <input id="password" name="password" type="password" autocomplete="current-password" required></p>
    <button type="submit">Sign in</button>
  </form>
  <p>Account registration is disabled. Ask an administrator to provision an account locally.</p>
</main>
</body>
</html>
