<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }} · Gungnir Inventory</title></head>
<body><main>
<a href="/">Dashboard</a> · <a href="/products">Products</a>
<form method="post" action="/logout"><input type="hidden" name="_token" value="{{ csrf }}"><button>Sign out</button></form>
<h1>Categories</h1>
<p>Categories are managed using the authenticated JSON API.</p>
<table><thead><tr><th>Code</th><th>Name</th></tr></thead><tbody>
@forelse(categories as category)
<tr><td>{{ category.code }}</td><td>{{ category.name }}</td></tr>
@empty
<tr><td colspan="2">No categories yet</td></tr>
@endforelse
</tbody></table>
@if(more)<p><a href="/categories?after={{ next }}">Next →</a></p>@endif
</main></body></html>
