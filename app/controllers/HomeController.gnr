controller HomeController {
    Response index(Request request) {
        return view('dashboard', {
            title: 'Gungnir Inventory',
            csrf: request.session().get('_gungnir_csrf_token'),
            user: request.user()
        });
    }

    Response health() {
        return json({status: 'ok', service: 'gungnir-inventory-management'});
    }
}
