model Product {
    table = 'products';
    timestamps = true;
    // Mass assignment of stock or archived status is forbidden: stock writes
    // require the Group 4 transactional ledger service.
    fillable = ['category_id', 'sku', 'name', 'unit_price_minor', 'reorder_level'];
    casts = {'active': 'bool'};

    int category_id;
    string sku;
    string name;
    int unit_price_minor;
    int stock_on_hand;
    int reorder_level;
    bool active;
}
