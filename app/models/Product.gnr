model Product {
    table = 'products';
    timestamps = true;
    // Product creation explicitly supplies stock=0 and active=true.
    // Controllers only pass validated metadata on subsequent updates.
    // Do not call create/update with an untrusted raw request object.
    fillable = ['category_id', 'sku', 'name', 'unit_price_minor', 'reorder_level', 'stock_on_hand', 'active'];
    casts = {'active': 'bool'};

    int category_id;
    string sku;
    string name;
    int unit_price_minor;
    int stock_on_hand;
    int reorder_level;
    bool active;
}
